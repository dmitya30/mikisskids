[Unit]
Description=Backup MIKISSKIDS orders database
After=tilda-webhook.service

[Service]
Type=oneshot
User=mikisskids-webhook
Group=mikisskids-webhook
EnvironmentFile=/etc/mikisskids/tilda-webhook.env
ExecStart=/opt/mikisskids/current/scripts/backup-orders-db
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/mikisskids
ReadWritePaths=/var/backups/mikisskids
