[Unit]
Description=Backup MIKISSKIDS orders database
After=tilda-webhook.service

[Service]
Type=oneshot
User=mikiss
Group=mikiss
EnvironmentFile=/etc/mikisskids/tilda-webhook.env
ExecStart=/var/www/mikiss/data/repos/mikisskids/scripts/backup-orders-db
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/mikisskids
ReadWritePaths=/var/backups/mikisskids
