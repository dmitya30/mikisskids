#!/usr/bin/env bash
set -Eeuo pipefail

REPO="/var/www/mikiss/data/repos/mikisskids"
WEBROOT="/var/www/mikiss/data/www/mikisskids.ru"
BACKUPS="/var/backups/mikisskids"
LOCKFILE="/run/lock/deploy-mikisskids.lock"
SITE_IP="5.183.190.117"
SITE_HOST="mikisskids.ru"

exec 9>"$LOCKFILE"

flock -n 9 || {
    echo "ERROR: another deployment is already running"
    exit 1
}

echo "===== MIKISSKIDS DEPLOY ====="
echo "Started: $(date -Is)"

test -d "$REPO/.git" || {
    echo "ERROR: repository not found: $REPO"
    exit 1
}

test -d "$WEBROOT" || {
    echo "ERROR: document root not found: $WEBROOT"
    exit 1
}

install -d -m 750 "$BACKUPS"

if [ -f "$WEBROOT/index.html" ]; then
    BACKUP="$BACKUPS/site-$(date +%Y%m%d-%H%M%S).tar"

    echo "Creating backup: $BACKUP"
    tar -C "$WEBROOT" -cf "$BACKUP" .

    find "$BACKUPS" \
        -maxdepth 1 \
        -type f \
        -name 'site-*.tar' \
        -printf '%T@ %p\n' |
        sort -nr |
        tail -n +6 |
        cut -d' ' -f2- |
        xargs -r rm -f --
fi

echo "Fetching origin/main..."
sudo -u mikiss -H git \
    -C "$REPO" \
    fetch --prune origin main

sudo -u mikiss -H git \
    -C "$REPO" \
    checkout -q main

sudo -u mikiss -H git \
    -C "$REPO" \
    reset --hard origin/main

echo "Synchronizing public files..."
sudo -u mikiss rsync -a --delete \
    --exclude='.git/' \
    --exclude='.github/' \
    --exclude='.gitignore' \
    --exclude='.env' \
    --exclude='.env.*' \
    --exclude='README.md' \
    --exclude='backend/' \
    --exclude='deploy/' \
    --exclude='docs/' \
    --exclude='scripts/' \
    "$REPO/" \
    "$WEBROOT/"

find "$WEBROOT" \
    -type d \
    -exec chmod 755 {} +

find "$WEBROOT" \
    -type f \
    -exec chmod 644 {} +

chown -R mikiss:mikiss "$WEBROOT"

echo "Checking that private directories are not public..."

for private_path in \
    backend \
    deploy \
    docs \
    scripts
do
    if [ -e "$WEBROOT/$private_path" ]; then
        echo "ERROR: private path exists in webroot: $private_path"
        exit 1
    fi
done

echo "Checking Nginx configuration..."
nginx -t

echo "Checking website..."
curl -fsS \
    -H "Host: $SITE_HOST" \
    "http://$SITE_IP/" \
    -o /dev/null

curl -fsS \
    -H "Host: $SITE_HOST" \
    "http://$SITE_IP/css/styles.css" \
    -o /dev/null

curl -fsS \
    -H "Host: $SITE_HOST" \
    "http://$SITE_IP/js/main.js" \
    -o /dev/null

COMMIT="$(
    sudo -u mikiss -H git \
        -C "$REPO" \
        rev-parse --short HEAD
)"

echo "Deployed commit: $COMMIT"
echo "Finished: $(date -Is)"
echo "===== DEPLOY SUCCESSFUL ====="
