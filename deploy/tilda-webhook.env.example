# Copy to /etc/mikisskids/tilda-webhook.env.
# Never add the real secret to Git.
WEBHOOK_SECRET=replace-with-random-secret-at-least-32-characters
DB_PATH=/var/lib/mikisskids/orders.sqlite3
BIND_HOST=127.0.0.1
PORT=8091
MAX_BODY_BYTES=65536
BACKUP_DIR=/var/backups/mikisskids/orders
BACKUP_RETENTION_DAYS=30
